[delta]
  minus-style                   = syntax "#f6e3e3"
  minus-non-emph-style          = syntax "#f6e3e3"
  minus-emph-style              = syntax "#e5aaaa"
  minus-empty-line-marker-style = syntax "#f6e3e3"
  line-numbers-minus-style      = "#c47981"
  plus-style                    = syntax "#e1eff1"
  plus-non-emph-style           = syntax "#e1eff1"
  plus-emph-style               = syntax "#a5ced4"
  plus-empty-line-marker-style  = syntax "#e1eff1"
  line-numbers-plus-style       = "#4197a4"
  line-numbers-zero-style       = "#a8aecb"
